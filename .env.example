# Copy this file to .env and fill in values.

# Required
DISCORD_TOKEN=
SQL_HOST=postgres
SQL_PORT=5432
SQL_USER=dinkboard
SQL_PASSWORD=
SQL_DATABASE=dinkboard
XAI_API_KEY=

# Optional: guild ID for instant slash-command sync on startup.
# Without this, commands sync globally (can take up to ~1 hour to appear).
# DISCORD_GUILD_ID=

# Optional: DINK awarded per successful /1st claim (default 1)
DINK_MINT_AMOUNT=1

# Optional: Postgres connection pool sizing (defaults: min 1, max 10)
# SQL_POOL_MIN_SIZE=1
# SQL_POOL_MAX_SIZE=10

# Nightly sentiment (xAI Grok structured outputs — scores messages missing from message_sentiment)
# GROK_SENTIMENT_MODEL=grok-4.3
# Optional cap per run (newest unscored first; useful while catching up historical holes)
# SENTIMENT_NIGHTLY_LIMIT=500
# Messages per Grok request (failed batches are logged and retried on the next run)
# SENTIMENT_BATCH_SIZE=10

# Daily Minecraft summary (8:00 AM America/New_York, previous 5 AM–5 AM play day).
# Compose mounts the external volume minecraft_data at /minecraft (read-only) and
# adds the bot container to gid 1000 so botuser can read that 1000:1000 volume.
# MINECRAFT_DATA_DIR=/minecraft
# Playday screenshots, one folder per morning the play day starts (YYYY-MM-DD).
# MC_RECAP_SCREENSHOT_DIR=/recap-screenshots
# MINECRAFT_CHANNEL_ID=581136950074015761
# GROK_MINECRAFT_MODEL=grok-4.7

# Lavalink (SoundCloud /play via the Soundy plugin). Compose sets LAVALINK_URI=http://lavalink:2333.
# Generate a long random password and use the same value for the Lavalink service.
LAVALINK_PASSWORD=
# Seconds with nothing playing before the bot leaves voice (default 300).
# MUSIC_INACTIVE_TIMEOUT=300

# Optional: enable interactive stdin-to-#general posting during local debugging
# ENABLE_CONSOLE_POST=0
