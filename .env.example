# Copy this file to .env and fill in values.

# Required
DISCORD_TOKEN=
SQL_HOST=postgres
SQL_USER=dinkboard
SQL_PASSWORD=
SQL_DATABASE=dinkboard
XAI_API_KEY=

# Optional: guild ID for instant slash-command sync on startup.
# Without this, commands sync globally (can take up to ~1 hour to appear).
# DISCORD_GUILD_ID=

# Optional: DINK awarded per successful /1st claim (default 1)
DINK_MINT_AMOUNT=1

# Nightly sentiment (cheap Grok via XAI_API_KEY — scores messages missing from message_sentiment)
# GROK_SENTIMENT_MODEL=grok-4.3
# Optional cap per run (newest unscored first; useful while catching up historical holes)
# SENTIMENT_NIGHTLY_LIMIT=500
# Messages per Grok request (falls back to per-message scoring if a batch response is bad)
# SENTIMENT_BATCH_SIZE=10

# Lavalink (SoundCloud /play). Compose sets LAVALINK_URI=http://lavalink:2333.
# Generate a long random password and use the same value for the Lavalink service.
LAVALINK_PASSWORD=
